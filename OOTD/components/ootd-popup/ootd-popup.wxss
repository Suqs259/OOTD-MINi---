.popup, .backdrop {
  position: fixed;
  inset: 0;
}

.popup { z-index: 20; }
.backdrop {
  background: rgba(11, 7, 24, .67);
  -webkit-backdrop-filter: blur(3px);
  backdrop-filter: blur(3px);
}

.sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  max-height: 94vh;
  overflow-x: hidden;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior: contain;
  border: 1px solid rgba(174, 145, 235, .33);
  border-bottom: 0;
  border-radius: 51rpx 51rpx 0 0;
  background: linear-gradient(155deg, #392b57, #211a36 67%);
  color: #fff;
  animation: sheet-in .24s ease-out both;
}

@keyframes sheet-in {
  from { transform: translateY(100%); }
}

.sheet-handle {
  width: 68rpx;
  height: 7rpx;
  margin: 17rpx auto 0;
  border-radius: 999rpx;
  background: rgba(221, 214, 254, .5);
}

.sheet-content { padding: 20rpx 34rpx calc(27rpx + env(safe-area-inset-bottom)); }
.between { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.sheet-heading { display: flex; min-width: 0; align-items: center; gap: 20rpx; }
.sheet-text { min-width: 0; }
.sheet-title { font-size: 39rpx; font-weight: 600; line-height: 1.25; }
.sheet-subtitle { margin-top: 4rpx; color: rgba(237, 233, 254, .8); font-size: 20rpx; line-height: 1.4; }
.sheet-icon, .round-button {
  display: flex;
  box-sizing: border-box;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
}

.sheet-icon {
  width: 65rpx;
  height: 65rpx;
  border: 1px solid rgba(189, 167, 255, .19);
  border-radius: 20rpx;
  background: linear-gradient(140deg, #9a65ff, #5735b9);
}
.brand-glyph { width: 36rpx; height: 36rpx; }
.round-button { width: 75rpx; height: 75rpx; border-radius: 50%; background: rgba(255, 255, 255, .1); }
.close-glyph { width: 34rpx; height: 34rpx; }
.arrow-glyph { width: 31rpx; height: 31rpx; }

.advice {
  margin-top: 27rpx;
  padding: 20rpx 27rpx;
  border: 1px solid rgba(196, 181, 253, .25);
  border-radius: 27rpx;
  background: rgba(167, 139, 250, .1);
}
.section-title { font-size: 27rpx; font-weight: 600; line-height: 1.5; }
.muted { color: rgba(237, 233, 254, .75); font-size: 20rpx; }
.advice-text { margin-top: 10rpx; color: #f5f3ff; font-size: 24rpx; line-height: 1.625; }
.inspiration { margin: 27rpx 0 14rpx; }
.carousel { height: 34vh; max-height: 562rpx; overflow: hidden; border-radius: 31rpx; }
.outfit-photo { display: block; width: 100%; height: 100%; }
.photo-caption {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 44rpx 27rpx 20rpx;
  background: linear-gradient(transparent, rgba(9, 6, 19, .87));
  font-size: 24rpx;
  font-weight: 600;
}
.carousel-controls { position: relative; width: 353rpx; height: 75rpx; margin: 14rpx auto 0; }
.carousel-prev, .carousel-next { position: absolute; top: 0; }
.carousel-prev { left: 0; }
.carousel-next { right: 0; }
.slide-dots { position: absolute; top: 0; right: 86rpx; bottom: 0; left: 86rpx; display: flex; align-items: center; justify-content: center; }
.slide-target { display: flex; width: 48rpx; height: 54rpx; flex-shrink: 0; align-items: center; justify-content: center; }
.dot { width: 15rpx; height: 15rpx; border-radius: 999rpx; background: #b6a4d3; }
.slide-target-active .dot { width: 36rpx; background: #e2c5ff; }

@media (prefers-reduced-motion: reduce) {
  .sheet { animation: none; }
}
