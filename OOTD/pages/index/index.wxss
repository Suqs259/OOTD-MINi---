@import "../../styles/page.wxss";

.content { padding: 22rpx 34rpx 30rpx; }
.section { margin-top: 20rpx; padding: 22rpx 26rpx; }
.section-title { font-size: 28rpx; font-weight: 600; }
.small { font-size: 22rpx; }
.muted { color: #cfc2e6; }
.hint { margin-top: 6rpx; color: #d7cbed; font-size: 22rpx; line-height: 1.55; }
.setup-hint { margin: 12rpx 0 20rpx; }

.weather-hero {
  position: relative;
  overflow: hidden;
  padding: 26rpx 32rpx;
  background: radial-gradient(ellipse at 78% 34%, rgba(147, 104, 231, .66), transparent 55%), linear-gradient(135deg, #4d358d, #302655 78%);
}

.weather-error { margin-top: 0; }
.weather-retry { display: inline-flex; min-width: 132rpx; margin-top: 18rpx; }
.weather-summary { position: relative; max-width: 61%; margin-top: 10rpx; }
.city { overflow: hidden; color: #f1e7ff; font-size: 25rpx; text-overflow: ellipsis; white-space: nowrap; }
.current { display: flex; align-items: flex-start; margin: 6rpx 0; font-size: 112rpx; font-weight: 300; letter-spacing: -7rpx; line-height: .96; font-variant-numeric: tabular-nums; }
.degree { margin: 3rpx 0 0 8rpx; font-size: 70rpx; }
.condition { font-size: 26rpx; font-weight: 600; }
.range { display: flex; align-items: center; gap: 12rpx; margin-top: 10rpx; color: #f1e7ff; font-size: 21rpx; white-space: nowrap; }
.temperature-track { width: 60rpx; height: 7rpx; border-radius: 30rpx; background: linear-gradient(90deg, #9a86e8, #fecc99); transform-origin: left; animation: temperature-in .6s ease-out both; }
.weather-art { position: absolute; top: 65rpx; right: 24rpx; display: flex; width: 255rpx; height: 230rpx; align-items: center; justify-content: center; pointer-events: none; }
.weather-emoji { font-size: 164rpx; line-height: 1.1; text-shadow: 0 18rpx 28rpx rgba(32, 12, 86, .5); animation: float-weather 5s ease-in-out infinite; }
.star { position: absolute; color: #e9cfff; font-size: 20rpx; }
.star-one { top: 10rpx; right: 26rpx; }
.star-two { top: 37rpx; left: 14rpx; }
.star-three { right: 10rpx; bottom: 33rpx; }
@keyframes float-weather { 50% { transform: translateY(-13rpx) rotate(3deg); } }
@keyframes temperature-in { from { transform: scaleX(0); } }

.metrics { position: relative; display: flex; margin-top: 22rpx; padding-top: 19rpx; border-top: 1px solid rgba(255, 255, 255, .2); }
.metric { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 5rpx; padding-left: 16rpx; font-size: 25rpx; font-weight: 600; }
.metric:first-child { padding-left: 0; }
.metric + .metric { border-left: 1px solid rgba(255, 255, 255, .2); }
.metric-label { color: #eee4ff; font-size: 21rpx; font-weight: 400; }
.forecast-heading { margin-bottom: 15rpx; }
.forecast-list { display: flex; gap: 7rpx; }
.forecast-day { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: center; gap: 2rpx; padding: 10rpx 0; border-radius: 23rpx; background: rgba(23, 17, 42, .25); }
.forecast-selected { background: rgba(172, 129, 250, .22); box-shadow: inset 0 0 0 1px rgba(195, 157, 254, .34); }
.forecast-pressed { background: rgba(172, 129, 250, .32); }
.forecast-emoji { font-size: 35rpx; line-height: 47rpx; }
.forecast-high { font-size: 24rpx; font-weight: 600; }

.style-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; margin: 17rpx 0; }
.style-grid .option { width: 100%; }
.primary.primary-disabled, .primary[disabled] { background: #423562; box-shadow: none; color: #e1d4f6; opacity: 1; filter: none; }

@media (prefers-reduced-motion: reduce) {
  .weather-emoji, .temperature-track { animation: none; }
}
