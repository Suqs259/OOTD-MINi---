<import src="../../templates/tab-bar.wxml" />

<view class="app-shell" wx:if="{{profile || onboardingRedirectFailed}}">
  <scroll-view class="app-scroll" scroll-y="{{!result}}">
    <view class="content">
      <block wx:if="{{weather}}">
        <view class="panel weather-hero">
          <view class="between">
            <text class="section-title">{{forecastIndex === 0 ? '今日天气' : weather.days[forecastIndex].day + '天气'}}</text>
          </view>
          <view class="weather-art" aria-hidden="true">
            <text class="star star-one">✦</text>
            <text class="star star-two">✧</text>
            <text class="star star-three">·</text>
            <text class="weather-emoji">{{forecastIndex === 0 ? weather.emoji : weather.days[forecastIndex].emoji}}</text>
          </view>
          <view class="weather-summary">
            <view class="city">📍 {{weather.city}}</view>
            <view class="current"><text>{{forecastIndex === 0 ? weather.now : weather.days[forecastIndex].high}}</text><text class="degree">°</text></view>
            <view class="condition">{{forecastIndex === 0 ? weather.label : weather.days[forecastIndex].label}}</view>
            <view class="range" wx:if="{{forecastIndex === 0}}">
              <text>最低 {{weather.low}}°</text>
              <view class="temperature-track"></view>
              <text>最高 {{weather.high}}°</text>
            </view>
            <view class="range" wx:else>预计最高气温</view>
          </view>
          <view class="metrics" wx:if="{{forecastIndex === 0}}">
            <view class="metric"><text class="metric-label">💧 湿度</text><text>{{weather.humidity === null ? '—' : weather.humidity + '%'}}</text></view>
            <view class="metric"><text class="metric-label">💨 风速</text><text>{{weather.wind === null ? '—' : weather.wind + ' km/h'}}</text></view>
            <view class="metric"><text class="metric-label">☔ 降水概率</text><text>{{weather.rain === null ? '—' : weather.rain + '%'}}</text></view>
          </view>
          <view class="metrics" wx:else>
            <view class="metric"><text class="metric-label">📅 日期</text><text>{{weather.days[forecastIndex].dateLabel}}</text></view>
            <view class="metric"><text class="metric-label">🌡️ 最低气温</text><text>{{weather.days[forecastIndex].low}}°</text></view>
            <view class="metric"><text class="metric-label">🌡️ 最高气温</text><text>{{weather.days[forecastIndex].high}}°</text></view>
          </view>
        </view>

        <view class="panel section">
          <view class="between forecast-heading">
            <text class="section-title">📅 近 7 日天气</text>
            <text class="muted small">°C</text>
          </view>
          <view class="forecast-list">
            <view wx:for="{{weather.days}}" wx:key="date" class="forecast-day {{index === forecastIndex ? 'forecast-selected' : ''}}" hover-class="forecast-pressed" hover-start-time="0" hover-stay-time="0" data-index="{{index}}" bindtap="selectForecastDay" aria-role="button" aria-pressed="{{index === forecastIndex}}" aria-label="{{item.day}}，{{item.label}}，最低{{item.low}}度，最高{{item.high}}度">
              <text class="small">{{item.day}}</text>
              <text class="forecast-emoji" aria-label="{{item.label}}">{{item.emoji}}</text>
              <text class="forecast-high">{{item.high}}°</text>
              <text class="muted small">{{item.low}}°</text>
            </view>
          </view>
        </view>
      </block>
      <weather-skeleton wx:elif="{{weatherStatus === 'loading'}}" />
      <view wx:elif="{{weatherStatus === 'error'}}" class="panel section weather-error">
        <text class="section-title">天气加载失败</text>
        <view class="hint">{{weatherError}}</view>
        <view class="option weather-retry" bindtap="loadWeather" aria-role="button">重试</view>
      </view>

      <view class="panel section">
        <text class="section-title">👕 今日穿搭风格</text>
        <block wx:if="{{profile}}">
          <view class="hint">选一个风格，根据今天的天气搭配。</view>
          <view class="style-grid">
            <button wx:for="{{styles}}" wx:key="*this" class="option {{selectedStyle === item ? 'option-selected' : ''}}" hover-class="none" aria-pressed="{{selectedStyle === item}}" data-style="{{item}}" bindtap="chooseStyle">{{item}}</button>
          </view>
          <button class="primary {{selectedStyle && weather ? '' : 'primary-disabled'}}" hover-class="{{selectedStyle && weather ? 'primary-pressed' : 'none'}}" hover-start-time="0" hover-stay-time="0" disabled="{{!selectedStyle || !weather}}" bindtap="generateOutfit">✨ 生成今日OOTD</button>
        </block>
        <block wx:else>
          <view class="hint setup-hint">先设置城市、性别和个人描述，即可选择穿搭风格。</view>
          <navigator class="primary" hover-class="primary-pressed" hover-start-time="0" hover-stay-time="0" open-type="redirect" url="/pages/onboarding/onboarding">👤 设置穿搭档案</navigator>
        </block>
      </view>
    </view>
  </scroll-view>

  <template is="tab-bar" data="{{active: 'weather'}}" />
</view>

<ootd-popup wx:if="{{result}}" result="{{result}}" bind:close="closeResult" />
