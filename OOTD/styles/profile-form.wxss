.profile-header {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 17rpx;
  padding: 0 34rpx;
  font-size: 39rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}
.profile-brand, .banner-icon {
  position: relative;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
}
.profile-brand {
  box-sizing: border-box;
  width: 65rpx;
  height: 65rpx;
  border: 1px solid rgba(189, 167, 255, .19);
  border-radius: 20rpx;
  background: linear-gradient(140deg, #9a65ff, #5735b9);
}
.profile-brand image { width: 36rpx; height: 36rpx; }
.profile-content { padding: 14rpx 34rpx 34rpx; }

.profile-banner {
  position: relative;
  overflow: hidden;
  margin-bottom: 34rpx;
  background: radial-gradient(circle at 74% 25%, rgba(141, 93, 204, .5), transparent 59%), linear-gradient(145deg, #493779, #2c214b);
}
.profile-title { position: relative; font-size: 41rpx; font-weight: 600; line-height: 1.25; }
.profile-orbit {
  position: absolute;
  top: 55rpx;
  left: 50%;
  box-sizing: border-box;
  width: 324rpx;
  height: 153rpx;
  border: 1px solid rgba(221, 189, 255, .21);
  border-radius: 50%;
  transform: translateX(-50%) rotate(-20deg);
}
.banner-icon {
  width: 116rpx;
  height: 116rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #bb83ff, #7746d7);
  box-shadow: 0 20rpx 38rpx rgba(33, 17, 66, .5), inset 0 1px 0 rgba(255, 255, 255, .33);
}
.banner-icon image { width: 55rpx; height: 55rpx; }
.setup-banner { padding: 41rpx 34rpx; }
.setup-banner .banner-copy { position: relative; z-index: 1; max-width: 384rpx; }
.setup-banner .profile-title { font-size: 44rpx; }
.banner-hint { margin-top: 14rpx; color: rgba(237, 233, 254, .8); font-size: 24rpx; line-height: 1.625; }
.setup-banner .profile-orbit { top: 41rpx; right: 14rpx; left: auto; width: 213rpx; height: 150rpx; transform: rotate(-20deg); }
.setup-banner .banner-icon { position: absolute; top: 55rpx; right: 55rpx; width: 109rpx; height: 109rpx; border-radius: 34rpx; transform: rotate(-12deg); }
.banner-sparkle { position: absolute; top: 34rpx; right: 34rpx; width: 27rpx; height: 27rpx; }

.profile-panel { display: block; padding: 34rpx; }
.profile-action { box-sizing: border-box; min-height: 82rpx; gap: 14rpx; max-width: none; }
.profile-action image, .field-label image { width: 31rpx; height: 31rpx; }

.field-group { margin-bottom: 41rpx; }
.field-label { display: flex; align-items: center; gap: 14rpx; margin-bottom: 14rpx; font-weight: 600; }
.field { box-sizing: border-box; width: 100%; height: 82rpx; padding: 0 24rpx; border: 1px solid rgba(184, 161, 240, .27); border-radius: 22rpx; background: #201934; color: #fff; font-size: 27rpx; }
.field-placeholder { color: #b6aacb; }
.description { display: block; height: 160rpx; padding: 17rpx 24rpx; line-height: 1.5; }
.count { margin-top: 7rpx; color: rgba(221, 214, 254, .75); font-size: 20rpx; text-align: right; }
.gender-options { display: flex; gap: 20rpx; }
.gender-options .option { flex: 1; min-height: 82rpx; gap: 14rpx; font-size: 27rpx; }
.gender-dot { box-sizing: border-box; display: flex; width: 27rpx; height: 27rpx; flex-shrink: 0; align-items: center; justify-content: center; border: 1px solid #8b8497; border-radius: 50%; background: #36323e; }
.option-selected .gender-dot { border-color: #a78bfa; background: #8b5cf6; }
.option-selected .gender-dot::after { width: 9rpx; height: 9rpx; border-radius: 50%; background: #fff; content: ""; }
.cancel { margin-top: 41rpx; color: #ddd6fe; font-size: 24rpx; text-align: center; }
